<?xml version="1.0" encoding="utf-8"?>
<!-- Card-Centerpiece: surface-Füllung, Ecken 20dp, 1dp-Rand, Innenabstand
     16dp (Layouts können den Innenabstand bei Bedarf überschreiben). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/boardStroke" />
    <padding
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp" />
</shape>
