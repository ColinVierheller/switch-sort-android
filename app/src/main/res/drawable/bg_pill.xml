<?xml version="1.0" encoding="utf-8"?>
<!-- Pill-Button mit Tiefenkante wie die Spielfeld-Blöcke:
     gedrückt sinkt die Oberfläche auf die Kante. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="@dimen/pill_depth">
                <shape android:shape="rectangle">
                    <solid android:color="@color/pillSurface" />
                    <corners android:radius="32dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="@dimen/pill_depth">
                <shape android:shape="rectangle">
                    <solid android:color="@color/pillEdge" />
                    <corners android:radius="32dp" />
                </shape>
            </item>
            <item android:bottom="@dimen/pill_depth">
                <shape android:shape="rectangle">
                    <solid android:color="@color/pillSurface" />
                    <corners android:radius="32dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
