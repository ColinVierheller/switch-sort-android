<?xml version="1.0" encoding="utf-8"?>
<!-- Eine Activity, vier Panels. Sichtbarkeit wird in MainActivity gesteuert.
     Klassische Android Views, keine Abhängigkeiten außer der Plattform.
     Design: ein Card-Centerpiece pro Panel auf ruhigem Hintergrund;
     alle Farben kommen ausschließlich aus @color (flippen mit values-night). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ============ Panel: Hauptmenü ============ -->
    <LinearLayout
        android:id="@+id/panel_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/menu_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/menu_title"
                android:textColor="@color/textPrimary"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_primary"
                android:minHeight="56dp"
                android:text="@string/menu_start"
                android:textAllCaps="false"
                android:textColor="@color/primaryText"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_scores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:minHeight="56dp"
                android:text="@string/menu_scores"
                android:textAllCaps="false"
                android:textColor="@color/primaryText"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:minHeight="56dp"
                android:text="@string/menu_options"
                android:textAllCaps="false"
                android:textColor="@color/primaryText"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_exit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:minHeight="56dp"
                android:text="@string/menu_exit"
                android:textAllCaps="false"
                android:textColor="@color/primaryText"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Panel: Optionen ============ -->
    <ScrollView
        android:id="@+id/panel_options"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/options_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/options_player_name"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/edit_player_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="username"
                    android:hint="@string/options_player_name"
                    android:importantForAccessibility="yes"
                    android:inputType="textPersonName"
                    android:singleLine="true"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary" />

                <TextView
                    android:id="@+id/text_options_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/errorColor"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/options_board_size_label"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/radio_board_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radio_board_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/options_board_3"
                        android:textColor="@color/textPrimary" />

                    <RadioButton
                        android:id="@+id/radio_board_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/options_board_4"
                        android:textColor="@color/textPrimary" />

                    <RadioButton
                        android:id="@+id/radio_board_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/options_board_5"
                        android:textColor="@color/textPrimary" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/options_theme_label"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/radio_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radio_theme_system"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/options_theme_system"
                        android:textColor="@color/textPrimary" />

                    <RadioButton
                        android:id="@+id/radio_theme_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/options_theme_light"
                        android:textColor="@color/textPrimary" />

                    <RadioButton
                        android:id="@+id/radio_theme_dark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/options_theme_dark"
                        android:textColor="@color/textPrimary" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_options_save"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_button_primary"
                    android:minHeight="56dp"
                    android:text="@string/options_save"
                    android:textAllCaps="false"
                    android:textColor="@color/primaryText"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_options_back"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_secondary"
                    android:minHeight="56dp"
                    android:text="@string/options_back"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ============ Panel: Highscore ============ -->
    <LinearLayout
        android:id="@+id/panel_scores"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/scores_title"
                android:textColor="@color/textPrimary"
                android:textSize="22sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/text_scores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />
            </ScrollView>

            <Button
                android:id="@+id/btn_scores_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_secondary"
                android:minHeight="56dp"
                android:text="@string/scores_back"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Panel: Spiel ============ -->
    <ScrollView
        android:id="@+id/panel_game"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_target_badge"
                    android:maxLines="1"
                    android:textColor="@color/accent"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/game_stat_label_score"
                            android:textColor="@color/textSecondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/text_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/textPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/game_stat_label_misses"
                            android:textColor="@color/textSecondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/text_misses"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/textPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/game_stat_label_time"
                            android:textColor="@color/textSecondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/text_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/textPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:typeface="monospace" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/text_finished"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/accent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <GridLayout
                    android:id="@+id/grid_board"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <Button
                    android:id="@+id/btn_restart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_primary"
                    android:minHeight="56dp"
                    android:text="@string/game_restart"
                    android:textAllCaps="false"
                    android:textColor="@color/primaryText"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_game_back"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_secondary"
                    android:minHeight="56dp"
                    android:text="@string/game_to_menu"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
