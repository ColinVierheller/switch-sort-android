<?xml version="1.0" encoding="utf-8"?>
<!-- Runder Fallback für API 23-25: ovale Grundfläche + Vordergrund. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="@color/iconBgBottom"
                android:startColor="@color/iconBgTop" />
        </shape>
    </item>
    <item
        android:width="64dp"
        android:height="64dp"
        android:drawable="@drawable/ic_launcher_fg"
        android:gravity="center" />
</layer-list>
